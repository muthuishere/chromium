# ---- SITE DEFINITIONS (ADR 0004) -------------------------------------------------------------
# Page-level truth — login url, the signed-in probe, the logout route, which verb reads the site —
# lives in sites/<domain>.json, resolved by scripts/sites.py with the INSTALLED copy
# (~/.config/chrome-agent/sites) winning over the shipped one. That is what lets a re-skinned site
# be fixed on a server with one JSON edit and no redeploy.
#
# The bash `case` fallbacks below stay for any domain that has no file yet: a missing asset must
# degrade to the behaviour we already proved, never to "unknown site".
SITES_PY="$SKILL/scripts/sites.py"
_site(){ python3 "$SITES_PY" field "$1" "$2" 2>/dev/null; }
_site_has(){ python3 "$SITES_PY" path "$1" >/dev/null 2>&1; }

# ---- IDENTITY: profile · login · auth (2026-09-12) -------------------------------------------
# apl (ADR-0007) treats `login` as a capability — "prepare the child process that ESTABLISHES the
# credential" — and its table had one blank row: browser:<label>, because this CLI had no sign-in
# command and no way to say whether a profile was signed in. Its probe could only check that a
# profile DIRECTORY existed, so a browser: handle could never report better than `unknown`, even
# with a dead session. These three verbs fill that row and need no new concept on apl's side.
#
# DOMAIN-SCOPED, NOT PROFILE-SCOPED, and that is the whole design: a browser profile is not signed
# into a thing, it is signed into many sites. A profile-level `signed_in: true` becomes a lie the
# moment one site's cookie expires while another's holds — a green light nobody verified, which is
# the exact failure this design exists to prevent. So: `auth linkedin.com`, never `auth`.

# Normalise whatever the caller typed into a bare host: a URL, a www., a trailing path.
_domain_norm(){ local d="${1:-}"
  d="${d#*://}"; d="${d%%/*}"; d="${d#www.}"; printf '%s' "$(printf '%s' "$d" | tr 'A-Z' 'a-z')"; }

# The per-site probe. READ-ONLY: it asks the page/site who it thinks we are and returns
# {signed_in, as?}. Each one is cookie-or-API, never a DOM guess at a login button, because a
# logged-out LinkedIn renders a perfectly valid-looking page at /feed/.
_auth_probe_js(){
  # The site file is the source of truth when it exists; the case below is the fallback for a
  # domain nobody has written a file for yet.
  local fromfile; fromfile="$(_site "$1" auth.probe_js)"
  if [ -n "$fromfile" ]; then printf '%s\n' "$fromfile"; return 0; fi
  case "$1" in
  linkedin.com) cat <<'JS'
// li_at is HttpOnly — document.cookie CANNOT see it, so gating on it reports every live session
// as logged out (proven 2026-09-12 on a valid session). Ask the API instead: the browser attaches
// the HttpOnly cookie itself, and 401/403 is the site's own verdict.
// FAILS CLOSED. An earlier cut returned signed_in:true from its catch block, so a network blip, a
// CSP refusal or a stale JSESSIONID on a logged-out page all reported green — on the one site
// where a false green already cost 44 hours of silent non-posting. JSESSIONID is the CSRF cookie
// and is set for anonymous visitors too: its ABSENCE is evidence, its presence is not.
const c = (() => { try { return document.cookie; } catch (e) { return ''; } })();
const csrf = (c.match(/JSESSIONID="?([^";]+)/) || [])[1] || '';
if (!csrf) return {signed_in:false, why:'no JSESSIONID — not a logged-in linkedin document'};
try {
  const r = await fetch('/voyager/api/me', {headers:{'csrf-token':csrf, accept:'application/json'}, credentials:'include'});
  if (r.status === 401 || r.status === 403) return {signed_in:false, why:'voyager/me '+r.status};
  if (!r.ok) return {signed_in:false, inconclusive:true, why:'voyager/me '+r.status+' — no verdict, treating as signed out'};
  const j = await r.json();
  const m = j.miniProfile || {};
  const as = [m.firstName, m.lastName].filter(Boolean).join(' ') || j.publicIdentifier || m.publicIdentifier;
  if (!as) return {signed_in:false, inconclusive:true, why:'voyager/me returned no identity'};
  return {signed_in:true, as};
} catch (e) {
  return {signed_in:false, inconclusive:true, why:'voyager/me unreachable: '+e.message};
}
JS
;;
  x.com|twitter.com) cat <<'JS'
// auth_token is HttpOnly; ct0 (the CSRF cookie) is not. But ct0 alone is WEAK — it is set during
// the login flow, before authentication completes — so it is necessary, not sufficient. The
// profile link is the corroborating evidence and the only source of the handle, and on a cold tab
// it can paint late, so wait for it briefly before deciding rather than calling a live session
// logged out because the SPA had not rendered.
const c = (() => { try { return document.cookie; } catch (e) { return ''; } })();
const link = () => document.querySelector('a[data-testid="AppTabBar_Profile_Link"]');
let a = link();
for (let i = 0; i < 10 && !a; i++) { await new Promise(r => setTimeout(r, 300)); a = link(); }
const as = a ? a.getAttribute('href').replace(/^\//,'') : undefined;
if (!/\bct0=/.test(c) && !a) return {signed_in:false, why:'no ct0 cookie and no profile link'};
if (!a) return {signed_in:false, inconclusive:true, why:'ct0 present but no profile link after 3s — a half-completed login flow looks exactly like this'};
return {signed_in:true, as};
JS
;;
  reddit.com) cat <<'JS'
// TRAP: /api/v1/me.json answers HTTP 200 when signed OUT — with a body of {"features":{...}} and
// no name. The status code is not the verdict here; the presence of `name` is. (Seen 2026-09-12.)
try {
  const r = await fetch('/api/v1/me.json', {credentials:'include', headers:{accept:'application/json'}});
  if (r.status === 401 || r.status === 403) return {signed_in:false, why:'me.json '+r.status};
  const j = await r.json();
  return j && j.name ? {signed_in:true, as:j.name} : {signed_in:false, why:'me.json has no name'};
} catch (e) { return {signed_in:false, why:'me.json failed: '+e.message}; }
JS
;;
  news.ycombinator.com) cat <<'JS'
const me = document.querySelector('#me, a[href^="user?id="]');
const logout = document.querySelector('a[href^="logout"]');
if (!logout) return {signed_in:false, why:'no logout link in the page top'};
return {signed_in:true, as: me ? me.textContent.trim() : undefined};
JS
;;
  github.com) cat <<'JS'
const m = document.querySelector('meta[name="user-login"]');
const as = m && m.content ? m.content : '';
return as ? {signed_in:true, as} : {signed_in:false, why:'no user-login meta'};
JS
;;
  youtube.com) cat <<'JS'
// YouTube states it itself: ytcfg.data_.LOGGED_IN. Cookies are the wrong evidence here — the
// readable ones (PREF, __Secure-3PAPISID) are present on a SIGNED-OUT page too, and the ones that
// mean anything (LOGIN_INFO, SAPISID) are HttpOnly. Verified signed-out here 2026-09-12.
const img = document.querySelector('#avatar-btn img, ytd-topbar-menu-button-renderer img');
const cfg = (window.ytcfg && window.ytcfg.data_) ? window.ytcfg.data_ : null;
if (cfg && typeof cfg.LOGGED_IN === 'boolean') {
  return cfg.LOGGED_IN ? {signed_in:true, as: img && img.alt ? img.alt : undefined}
                       : {signed_in:false, why:'ytcfg.LOGGED_IN is false'};
}
return img ? {signed_in:true, as: img.alt || undefined}
           : {signed_in:false, why:'no ytcfg verdict and no avatar button'};
JS
;;
  facebook.com) cat <<'JS'
const c = (() => { try { return document.cookie; } catch (e) { return ''; } })();
const m = c.match(/\bc_user=(\d+)/);
return m ? {signed_in:true, as:'fbid:'+m[1]} : {signed_in:false, why:'no c_user cookie'};
JS
;;
  instagram.com) cat <<'JS'
// sessionid is HttpOnly; ds_user_id is the readable half of the same session.
const c = (() => { try { return document.cookie; } catch (e) { return ''; } })();
const m = c.match(/\bds_user_id=(\d+)/);
return m ? {signed_in:true, as:'igid:'+m[1]} : {signed_in:false, why:'no ds_user_id cookie'};
JS
;;
  *) return 1 ;;
esac; }

_auth_domains(){
  # Whatever has a site file, plus the built-in fallbacks, deduped.
  { python3 "$SITES_PY" list --json 2>/dev/null | python3 -c 'import json,sys
try: print(" ".join(r["domain"] for r in json.load(sys.stdin)))
except Exception: pass' 2>/dev/null
    printf 'linkedin.com x.com reddit.com news.ycombinator.com github.com youtube.com facebook.com instagram.com'
  } | tr ' ' '\n' | sed '/^$/d' | sort -u | tr '\n' ' ' | sed 's/ $//'; echo; }

# auth <domain> -> {domain, profile, signed_in, as?}  ·  exit 0 signed in, 2 not, 3 no browser.
# It navigates THIS SESSION'S OWN TAB to the domain, because a cookie is origin-scoped and a
# credentialed probe run from the wrong origin reports a false logged-out — the failure that once
# cost 44 hours of LinkedIn posting while the session was perfectly valid.
auth(){ local domain; domain="$(_domain_norm "${1:-}")"
  [ -n "$domain" ] || die "$EX_USAGE" "usage" "auth <domain> — e.g. chrome-agent auth linkedin.com. Probed domains: $(_auth_domains)"
  local js; js="$(_auth_probe_js "$domain")" || die "$EX_USAGE" "no-probe" "no auth probe for $domain — a guess here would report a green light nobody verified. Probed domains: $(_auth_domains)"
  cj eval "1" >/dev/null 2>&1 || die "$EX_BROWSER" "browser-down" "no browser is servicing $SPOOL — run: chrome-agent up"
  # A cookie is origin-scoped and half these probes ask the site's own API, so the page matters:
  # auth.probe_url, else home, else the bare root.
  local url; url="$(_site "$domain" auth.probe_url)"; [ -n "$url" ] || url="$(_site "$domain" home)"
  [ -n "$url" ] || url="https://$domain/"
  goto "$url" 5
  local res; res=$(evalwithcsp "$js" 15)
  python3 -c 'import json,sys
raw=sys.stdin.read().strip()
try: v=json.loads(raw)
except Exception: v=None
if not isinstance(v,dict) or "signed_in" not in v:
    print(json.dumps({"domain":sys.argv[1],"profile":sys.argv[2],"signed_in":None,
                      "error":"probe returned no verdict","detail":raw[:200]},separators=(",",":")))
    sys.exit(3)
out={"domain":sys.argv[1],"profile":sys.argv[2],"signed_in":bool(v.get("signed_in"))}
for k in ("as","why","inconclusive"):
    if v.get(k): out[k]=v[k]
# An UNVERIFIED definition is a hypothesis written from documentation. Saying so in the same
# breath as the verdict is what keeps a guess from reading like proof.
if len(sys.argv)>3 and sys.argv[3]=="unverified":
    out["definition"]="unverified"
    out["note"]="this site definition has never been proven live — treat the verdict as provisional"
print(json.dumps(out,separators=(",",":")))
sys.exit(0 if out["signed_in"] else 2)' "$domain" "$PROFILE" "$(_site "$domain" status)" <<<"$res"
}

# login <domain> — open the window at that site and GET OUT OF THE WAY.
# It types NOTHING. Never a credential, never a 2FA code, never a "helpful" click on a provider
# button. A password that an agent can type is a password inside an agent's context, and automated
# sign-in is the fastest way to get an account restricted. apl execs this and then verifies with
# `auth` — that is ADR-0008's manual-login rule, in one command.
login(){ local domain; domain="$(_domain_norm "${1:-}")"
  [ -n "$domain" ] || die "$EX_USAGE" "usage" "login <domain> — e.g. chrome-agent login linkedin.com"
  _require_fork; _require_binary
  local url note twofa
  url="$(_site "$domain" login.url)"; [ -n "$url" ] || url="https://$domain/"
  note="$(_site "$domain" login.note)"; twofa="$(_site "$domain" login.twofa)"
  # HEADLESS CANNOT BE SIGNED IN BY A HUMAN. On a server the window lives on a virtual display and
  # is reached through `chrome-agent share` (ADR 0003); say that instead of opening a window nobody
  # can see and then waiting for a login that can never happen.
  if [ "${CHROMIUM_AGENT_HEADLESS:-}" = "1" ] || [ "${CHROME_AGENT_HEADLESS:-}" = "1" ]; then
    python3 -c 'import json,sys;print(json.dumps({"status":"needs-a-screen","domain":sys.argv[1],"profile":sys.argv[2],
      "why":"this profile is running headless, and a human cannot sign in to a window that is not drawn",
      "do":"on a server: chrome-agent share start  (then open the URL, sign in, chrome-agent share stop)",
      "then":"chrome-agent auth "+sys.argv[1]},separators=(",",":")))' "$domain" "$PROFILE"
    return 0
  fi
  if ! cj eval "1" >/dev/null 2>&1; then up "$url" >/dev/null; else cjt goto "$url" >/dev/null 2>&1; fi
  sleep 3
  python3 -c 'import json,sys;print(json.dumps({"status":"awaiting-human","domain":sys.argv[1],"profile":sys.argv[2],
    "opened":sys.argv[3],
    "expect":sys.argv[4] or None,
    "twofa":(sys.argv[5]=="true") if sys.argv[5] else None,
    "note":"the browser window is open at this site in this profile. Sign in BY HAND — this command types nothing and never will.",
    "then":"chrome-agent auth "+sys.argv[1]},separators=(",",":")))' "$domain" "$PROFILE" "$url" "$note" "$twofa"
}

# profile create <dir> — make a profile, do NOT launch.
# apl must never mkdir a profile itself: a bare directory is a logged-OUT profile that looks
# configured, and apl would report it healthy. Creating it here means the answer also carries the
# spool this profile will really use, derived by the same function `up` uses.
profile_create(){ local dir="${1:-}"
  [ -n "$dir" ] || die "$EX_USAGE" "usage" "profile create <dir>"
  dir="${dir%/}"
  local existed=false; [ -d "$dir" ] && existed=true
  mkdir -p "$dir" || die "$EX_USAGE" "mkdir-failed" "could not create $dir"
  python3 -c 'import json,sys;print(json.dumps({"profile":sys.argv[1],"existed":sys.argv[2]=="true","spool":sys.argv[3],
    "launch":"CHROME_AGENT_PROFILE="+sys.argv[1]+" chrome-agent up",
    "note":"created empty and signed out of everything. Sign in per site: CHROME_AGENT_PROFILE=... chrome-agent login <domain>"},separators=(",",":")))' \
    "$dir" "$existed" "$(_spool_for "$dir")"
}

# exit-codes [--json] — the contract, readable by the thing that maps it.
exit_codes(){
  if [ "${1:-}" = "--json" ]; then
    printf '%s\n' '[{"code":0,"name":"ok","means":"the command did what it says"},{"code":1,"name":"usage","means":"bad or missing argument; nothing was attempted"},{"code":2,"name":"not-signed-in","means":"the profile has no valid session for that site — a human must sign in"},{"code":3,"name":"browser-unreachable","means":"no fork, no build, or no browser servicing the spool"},{"code":4,"name":"site-refused","means":"the browser worked and the site said no"}]'
  else
    printf '  0  ok               the command did what it says\n  1  usage            bad or missing argument; nothing was attempted\n  2  not-signed-in    no valid session for that site — a human must sign in\n  3  browser-unreachable  no fork, no build, or no browser servicing the spool\n  4  site-refused     the browser worked and the site said no\n'
  fi
}

# ---- LEARNED -> CANON (2026-09-12) -----------------------------------------------------------
# `note` captures a thing you learned about a site the moment you learn it; `promote` shows what is
# known but not written down, and appends it into the playbook's kept block. See scripts/promote.py
# for why this exists (ADR-0008 requires review and shipped no tooling for it).
LEARNED_DIR="$HOME/.config/chrome-agent/learned"
note(){ local domain; domain="$(_domain_norm "${1:-}")"; local text="${2:-}"
  [ -n "$domain" ] && [ -n "$text" ] || die "$EX_USAGE" "usage" "note <domain> \"<what you learned>\""
  mkdir -p "$LEARNED_DIR"
  python3 -c 'import json,sys,datetime
rec={"ts":datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),"domain":sys.argv[1],
     "text":sys.argv[2],"promoted":False}
open(sys.argv[3],"a").write(json.dumps(rec,separators=(",",":"))+"\n")
print(json.dumps({"noted":rec["domain"],"text":rec["text"],"promote_with":"chrome-agent promote "+rec["domain"]},separators=(",",":")))' \
    "$domain" "$text" "$LEARNED_DIR/$domain.ndjson"; }
promote(){ local domain="" flags=""
  for a in "$@"; do case "$a" in
    --*) flags="$flags $a" ;;
    ?*)  [ -z "$domain" ] && domain="$(_domain_norm "$a")" ;;
  esac; done
  python3 "$SKILL/scripts/promote.py" ${domain:+"$domain"} $flags; }

# ---- Hacker News READ (2026-09-12) -----------------------------------------------------------
# HN could post and comment and could not read a single thing back — while its own traps file says
# "HN serves HTTP 200 on a dead or flagged post, open the item and read it back". The rule demanded
# a verb the site did not have. These two are CLI-side DOM reads (HN has no API worth replaying and
# no CSP to fight) and they report the two states a 200 hides: [flagged] and [dead].
hn_item(){ # $1 = item url or bare id
  local id="${1:-}" url
  [ -n "$id" ] || die "$EX_USAGE" "usage" "hackernews item <url-or-id>"
  case "$id" in
    http*) url="$id" ;;
    *[!0-9]*) die "$EX_USAGE" "usage" "hackernews item <url-or-id> — got '$id'" ;;
    *) url="https://news.ycombinator.com/item?id=$id" ;;
  esac
  goto "$url" 4
  local res; res=$(evalwithcsp '
const q=(s,r)=>(r||document).querySelector(s);
const title=q(".titleline a")?q(".titleline a").textContent.trim():(q(".title")?q(".title").textContent.trim():null);
const sub=q(".subtext")?q(".subtext").textContent.trim():"";
const head=document.body.innerText.slice(0,400);
// A dead or flagged item still answers 200; the only evidence is in the page text.
const flagged=/\[flagged\]/i.test(head), dead=/\[dead\]/i.test(head);
const comments=[...document.querySelectorAll("tr.comtr")].map(tr=>{
  const ind=tr.querySelector("td.ind img");
  const body=tr.querySelector(".commtext");
  return {
    depth: ind?Math.round(parseInt(ind.getAttribute("width")||"0",10)/40):0,
    author: tr.querySelector(".hnuser")?tr.querySelector(".hnuser").textContent.trim():null,
    age: tr.querySelector(".age")?tr.querySelector(".age").textContent.trim():null,
    dead: !!tr.querySelector(".comhead .dead") || (body?/^\s*\[(dead|flagged)\]/i.test(body.innerText):false),
    text: body?body.innerText.trim().slice(0,2000):null,
  };
});
const pts=sub.match(/(\d+)\s+points?/);
return {site:"hackernews",recipe:"item",url:location.href,capturedAt:new Date().toISOString(),
        title,points:pts?parseInt(pts[1],10):null,flagged,dead,
        commentCount:comments.length,comments};' 20)
  echo "$res"; log "hackernews:item" "$url" "$res"
}
hn_top(){ # $1=count (default 30)
  local n="${1:-30}"
  case "$n" in ''|*[!0-9]*) n=30 ;; esac   # this value is interpolated into page JS — digits only
  goto "https://news.ycombinator.com/" 4
  local res; res=$(evalwithcsp "
const rows=[...document.querySelectorAll('tr.athing.submission')].slice(0,$n).map(tr=>{
  const a=tr.querySelector('.titleline a');
  const sub=tr.nextElementSibling;
  const txt=sub?sub.innerText:'';
  const pts=txt.match(/(\\d+)\\s+points?/), cmt=txt.match(/(\\d+)\\s+comments?/);
  return {id:tr.id,title:a?a.textContent.trim():null,url:a?a.href:null,
          by:sub&&sub.querySelector('.hnuser')?sub.querySelector('.hnuser').textContent.trim():null,
          points:pts?parseInt(pts[1],10):null,comments:cmt?parseInt(cmt[1],10):0,
          item:'https://news.ycombinator.com/item?id='+tr.id};
});
return {site:'hackernews',recipe:'top',url:location.href,capturedAt:new Date().toISOString(),
        postCount:rows.length,posts:rows};" 20)
  echo "$res"; log "hackernews:top" "front-page" "$res"
}

# ---- logout <domain> (ADR 0005) --------------------------------------------------------------
# We could acquire an identity and could not put one down. On a shared or server machine that is
# backwards: the risky state is a session left lying around, and that was the one with no command.
#
# DOMAIN-SCOPED like login/auth: ending one site must not touch the others in the profile.
# Method comes from the site definition, and the three are NOT equivalent — the output says which
# one ran, because "we cleared cookies locally" and "the site ended your session" are different
# facts and only one of them revokes anything server-side.
logout(){ local domain; domain="$(_domain_norm "${1:-}")"
  [ -n "$domain" ] || die "$EX_USAGE" "usage" "logout <domain> — e.g. chrome-agent logout linkedin.com"
  cj eval "1" >/dev/null 2>&1 || die "$EX_BROWSER" "browser-down" "no browser is servicing $SPOOL — run: chrome-agent up"
  local method url selector note home
  method="$(_site "$domain" logout.method)"; url="$(_site "$domain" logout.url)"
  selector="$(_site "$domain" logout.selector)"; note="$(_site "$domain" logout.note)"
  home="$(_site "$domain" home)"; [ -n "$home" ] || home="https://$domain/"
  [ -n "$method" ] || method="cookies"
  local did=""
  case "$method" in
    url)
      [ -n "$url" ] || die "$EX_USAGE" "bad-definition" "logout.method=url but the site file has no logout.url for $domain"
      goto "$url" 6; did="navigated the site's own logout route" ;;
    dom)
      [ -n "$selector" ] || die "$EX_USAGE" "bad-definition" "logout.method=dom but the site file has no logout.selector for $domain"
      goto "$home" 5
      # Clicking the site's OWN control is the only write this CLI performs without --confirm, and
      # it is safe in exactly one direction: it can only end a session, never start or publish one.
      evalwithcsp "const b=document.querySelector($(printf '%s' "$selector" | python3 -c 'import json,sys;print(json.dumps(sys.stdin.read()))')); if(!b) return 'no-control'; b.click(); return 'clicked';" 10 >/dev/null
      sleep 4; did="clicked the site's own logout control" ;;
    cookies)
      # LAST RESORT, and the output must never let it pass for a real logout: this ends the LOCAL
      # session only. The server-side session stays alive until it expires on its own.
      goto "$home" 4
      evalwithcsp '
const names = (() => { try { return document.cookie.split(";").map(c => c.trim().split("=")[0]).filter(Boolean); } catch (e) { return []; } })();
const host = location.hostname.replace(/^www\./, "");
const paths = ["/", location.pathname];
const domains = ["", host, "." + host, "." + host.split(".").slice(-2).join(".")];
for (const n of names) for (const p of paths) for (const d of domains) {
  document.cookie = n + "=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=" + p + (d ? "; domain=" + d : "");
}
try { localStorage.clear(); sessionStorage.clear(); } catch (e) {}
return {cleared: names.length};' 12 >/dev/null
      sleep 2; did="cleared this origin's readable cookies and web storage — the SERVER-side session may still be live" ;;
    *) die "$EX_USAGE" "bad-definition" "logout.method must be url|dom|cookies (got '$method')" ;;
  esac
  # VERIFY. Every other verb here proves its effect; a logout that says "done" without checking is
  # the same lie as a 200 on a dead post.
  local after rc; after="$($CA_SELF auth "$domain" 2>/dev/null)"; rc=$?
  log "logout:$domain" "$domain" "$method/$did rc=$rc"
  python3 -c 'import json,sys
rc=int(sys.argv[4]); after=sys.argv[5]
try: a=json.loads(after)
except Exception: a={}
out={"domain":sys.argv[1],"profile":sys.argv[2],"method":sys.argv[3],"did":sys.argv[6],
     "signed_out":rc==2,"auth_after":a}
if sys.argv[7]: out["note"]=sys.argv[7]
if sys.argv[3]=="cookies":
    out["warning"]="local only — the site was never told, so its session persists until it expires"
print(json.dumps(out,separators=(",",":")))
# Idempotent by intent: "be signed out" is satisfied whether or not we had to do anything.
sys.exit(0 if rc==2 else 4)' "$domain" "$PROFILE" "$method" "$rc" "$after" "$did" "$note"
}

# ---- profile lifecycle (ADR 0005) ------------------------------------------------------------
# On a server nobody can see these directories, and a profile whose spool is not what you expect is
# the bug class that already cost two incidents (a trailing slash forked one profile into two
# spools; a basename collision merged two profiles into one). So: list them, with their spools.
profile_list(){
  local dirs=""; for d in "$HOME"/chrome-agent-profile* "$HOME"/.config/chrome-agent/profiles/*; do
    [ -d "$d" ] && case "$d" in *'*'*) ;; *) dirs="$dirs $d";; esac
  done
  [ -n "${CHROME_AGENT_PROFILE:-}" ] && [ -d "${CHROME_AGENT_PROFILE%/}" ] && dirs="$dirs ${CHROME_AGENT_PROFILE%/}"
  # SingletonLock is a SYMLINK to "<host>-<pid>", a target that never exists as a file — so `-e`
  # (which follows the link) reports "free" while a browser is running. Test the link itself, then
  # ask whether the pid is alive: a lock with no live owner is the stale one that makes the next
  # `up` a silent no-op.
  { for d in $dirs; do
      local lk="free" tgt pid
      if [ -L "$d/SingletonLock" ]; then
        tgt="$(readlink "$d/SingletonLock" 2>/dev/null || true)"; pid="${tgt##*-}"
        case "$pid" in ''|*[!0-9]*) pid="" ;; esac
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then lk="running:$pid"; else lk="STALE-LOCK"; fi
      fi
      printf '%s\t%s\t%s\t%s\n' "$d" "$(_spool_for "$d")" \
        "$(du -sh "$d" 2>/dev/null | cut -f1)" "$lk"; done; } \
  | sort -u | python3 -c 'import sys,json
rows=[]
for l in sys.stdin:
    p=l.rstrip("\n").split("\t")
    if len(p)==4 and p[0]:
        rows.append({"profile":p[0],"spool":p[1],"size":p[2],"lock":p[3]})
print(json.dumps({"count":len(rows),"profiles":rows},indent=2))'
}
profile_delete(){ local dir="${1:-}" yes="${2:-}"
  [ -n "$dir" ] || die "$EX_USAGE" "usage" "profile delete <dir> [--yes]"
  dir="${dir%/}"
  [ -d "$dir" ] || die "$EX_USAGE" "no-such-profile" "no profile at $dir"
  # Deleting a profile is the ONLY way we can revoke a browser identity, so it must read like a
  # revocation and not like rm: refuse while it is live, refuse the default by accident, and say
  # what is inside before asking.
  local spool; spool="$(_spool_for "$dir")"
  # `-L`, not `-e`: the lock is a symlink whose target never exists, so `-e` is always false and the
  # "is it running?" guard never fired.
  if [ -L "$dir/SingletonLock" ] || [ -e "$dir/SingletonLock" ]; then
    local tgt pid; tgt="$(readlink "$dir/SingletonLock" 2>/dev/null || true)"; pid="${tgt##*-}"
    case "$pid" in ''|*[!0-9]*) pid="" ;; esac
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      die "$EX_USAGE" "profile-in-use" "a browser (pid $pid) is running on $dir — close it first; deleting a live profile loses every session in it"
    fi
  fi
  if [ "$dir" = "$HOME/chrome-agent-profile" ] && [ "$yes" != "--force" ]; then
    die "$EX_USAGE" "default-profile" "$dir is the DEFAULT profile — every existing script and session uses it. Pass --force if you really mean it."
  fi
  if [ "$yes" != "--yes" ] && [ "$yes" != "--force" ]; then
    python3 -c 'import json,sys;print(json.dumps({"about_to_delete":sys.argv[1],"spool":sys.argv[2],
      "size":sys.argv[3],"staged":True,
      "warning":"this destroys every site session in this profile — it is a revocation, not a cleanup",
      "note":"pass --yes to actually delete"},separators=(",",":")))' \
      "$dir" "$spool" "$(du -sh "$dir" 2>/dev/null | cut -f1)"
    return 0
  fi
  rm -rf "$dir" && rm -rf "$spool"
  log "profile:delete" "$dir" "deleted with spool $spool"
  python3 -c 'import json,sys;print(json.dumps({"deleted":sys.argv[1],"spool_removed":sys.argv[2]},separators=(",",":")))' "$dir" "$spool"
}

# ---- doctor (ADR 0006) -----------------------------------------------------------------------
# A CLI newer than its engine discovers that as a command that hangs forever, which is the worst
# error a system can give. doctor asks every question whose wrong answer produces a hang.
doctor(){
  local bin; bin="$(_fork_binary)"
  python3 -c 'import json,os,shutil,subprocess,sys
fork,cjs,launch,binary,spool,profile,sites=sys.argv[1:8]
def ok(p): return os.path.exists(p)
res={
 "fork":{"path":fork,"present":os.path.isdir(fork),"cli":ok(cjs),"launcher":ok(launch),
         "binary":binary,"built":os.access(binary,os.X_OK)},
 "profile":{"path":profile,"exists":os.path.isdir(profile),
            "locked":os.path.lexists(os.path.join(profile,"SingletonLock"))},
 "spool":{"path":spool,"exists":os.path.isdir(spool)},
 "tools":{t:bool(shutil.which(t)) for t in ("node","python3","cloudflared","Xvfb","x11vnc")},
 "sites":{"dir":sites},
}
missing=[]
if not res["fork"]["cli"] or not res["fork"]["launcher"]: missing.append("fork (set CHROME_AGENT_FORK)")
if not res["fork"]["built"]: missing.append("built binary (autoninja -C out/Default chrome)")
for t in ("node","python3"):
    if not res["tools"][t]: missing.append(t)
res["ready"]=not missing
res["missing"]=missing
if not res["tools"]["cloudflared"]:
    res.setdefault("notes",[]).append("cloudflared absent — `share` (remote login, ADR 0003) will not work")
if not res["tools"]["Xvfb"]:
    res.setdefault("notes",[]).append("Xvfb absent — headful login on a server needs it (macOS desktops do not)")
print(json.dumps(res,indent=2))
sys.exit(0 if res["ready"] else 3)' "$FORK" "$CJS" "$LAUNCH" "$bin" "$SPOOL" "$PROFILE" "$HOME/.config/chrome-agent/sites"
}

# ---- share: the time-boxed login window (ADR 0003) -------------------------------------------
share(){ local sh="$SKILL/scripts/share.sh"
  [ -x "$sh" ] || [ -f "$sh" ] || die "$EX_USAGE" "not-installed" "scripts/share.sh is not present in this install"
  bash "$sh" "$@"; }

# ---- read <domain> — every known site answers, whether or not it has a recipe -----------------
# 12 of the 19 site definitions have no read recipe yet (read.verb = "eval"), and "we know this
# site but cannot read it" is a useless kind of knowing. The site file already names the page worth
# reading, and the registry already has generic readers, so: a site with a recipe runs it, and a
# site without one gets the generic reader pointed at its fixture page. The output always says
# which happened, because a generic page-text read is a weaker thing than a site's own API replay
# and must never be mistaken for one.
read_site(){ local domain; domain="$(_domain_norm "${1:-}")"
  [ -n "$domain" ] || die "$EX_USAGE" "usage" "read <domain> [generic-recipe]  — e.g. chrome-agent read linkedin.com"
  cj eval "1" >/dev/null 2>&1 || die "$EX_BROWSER" "browser-down" "no browser is servicing $SPOOL — run: chrome-agent up"
  local gen="${2:-generic:page-text}" plan key cli url res how
  plan="$(_verify_plan "$domain")"
  key="$(printf '%s' "$plan" | cut -f1)"; cli="$(printf '%s' "$plan" | cut -f2)"; url="$(printf '%s' "$plan" | cut -f3)"
  goto "$url" 6
  if [ -n "$key" ]; then
    how="$key"
    if [ -n "$cli" ]; then res="$($CA_SELF ${cli#chrome-agent } 2>/dev/null)"; else res="$(recipe "$key")"; fi
  else
    how="$gen"; res="$(recipe "$gen")"
  fi
  python3 -c 'import json,sys
res=sys.stdin.read().strip()
try: v=json.loads(res)
except Exception: v={"raw":res[:2000]}
out={"domain":sys.argv[1],"read_with":sys.argv[2],"page":sys.argv[3],
     "definition":sys.argv[4] or "none",
     "generic":sys.argv[2].startswith("generic:"),
     "result":v}
if out["generic"]:
    out["note"]="this site has no read recipe — you are getting the page as text, not its API. "\
                "Promote it: capture the real call (chrome-agent capture arm|dump) and add a recipe."
print(json.dumps(out,separators=(",",":")))' "$domain" "$how" "$url" "$(_site "$domain" status)" <<<"$res"
}

# ---- install (ADR 0004 + 0006) ---------------------------------------------------------------
# One command that makes this machine ready, and puts the editable half where it can be edited:
#   ~/.config/chrome-agent/sites/    the site definitions — THE place to fix a re-skinned page
#   ~/.config/chrome-agent/learned/  notes waiting to be promoted into canon
#   ~/.local/bin/chrome-agent        the CLI on PATH
# It is idempotent, it never overwrites a site file you edited (that needs `sites sync --force`),
# and it ends by running doctor, because "installed" and "able to run" are different claims.
install_(){ local bindir="${1:-$HOME/.local/bin}"
  mkdir -p "$HOME/.config/chrome-agent/sites" "$HOME/.config/chrome-agent/learned" \
           "$HOME/.config/chrome-agent/share" "$bindir"
  python3 "$SITES_PY" sync >/dev/null
  # A symlink, not a copy: a copy is a second version of the CLI that ages silently.
  if [ ! -e "$bindir/chrome-agent" ] || [ -L "$bindir/chrome-agent" ]; then
    ln -sf "$CA_SELF" "$bindir/chrome-agent"
  fi
  python3 -c 'import json,os,sys
sites=sys.argv[2]
print(json.dumps({"cli":sys.argv[1],"on_path":os.path.join(sys.argv[3],"chrome-agent"),
  "sites_installed":sites,
  "edit_here":"a page changed? edit %s/<domain>.json — it wins over the shipped copy, no redeploy" % sites,
  "learned":sys.argv[4],
  "next":["chrome-agent doctor","chrome-agent sites list","chrome-agent auth <domain>"]},indent=2))' \
    "$CA_SELF" "$HOME/.config/chrome-agent/sites" "$bindir" "$HOME/.config/chrome-agent/learned"
}

# ---- verify <domain> — make `last_verified` mean something (2026-09-12) ----------------------
# The playbooks' `last_verified` was stamped at GENERATION time, which proves only that someone ran
# a generator. It said nothing about whether the site still answers, so a playbook could age into
# fiction while displaying a fresh-looking date. This runs the site's real read recipe (or, where a
# site has none, its auth probe), stamps the date ONLY on success, and fails loudly otherwise.
PLAYBOOKS="$SKILL/playbooks"
# THE VERIFY FIXTURE — a read verb needs the right PAGE, not just the right origin.
# Every remaining "0 items" was this: youtube:channel-videos scrapes THE CURRENT PAGE, so the
# homepage yields nothing and the site looked broken; instagram:post wants an open post, not a
# profile root. So each domain names the verb to run and the page to run it on. A domain with no
# fixture falls back to the first registered read and the site root.
_verify_fixture(){ case "$1" in
  youtube.com)          echo 'youtube:channel-videos|https://www.youtube.com/results?search_query=chromium' ;;
  instagram.com)        echo 'instagram:profile|https://www.instagram.com/instagram/' ;;
  news.ycombinator.com) echo 'hackernews:top|https://news.ycombinator.com/' ;;
  *) echo '' ;;
esac; }

# _verify_plan <domain> -> "key<TAB>cli<TAB>url"; cli is empty for a registry recipe.
_verify_plan(){ local domain="$1" fx key url
  # The site definition owns this now (ADR 0004); the bash table is the fallback for a domain with
  # no file. "eval" means the site has no read recipe yet — there is nothing to run, so verify
  # falls through to the auth probe, which is the honest answer for those sites.
  key="$(_site "$domain" read.verb)"; url="$(_site "$domain" read.fixture_url)"
  [ "$key" = "eval" ] && key=""
  if [ -z "$key" ] && [ -z "$url" ]; then
    fx="$(_verify_fixture "$domain")"; key="${fx%%|*}"; url="${fx#*|}"
    [ -n "$fx" ] || { key=""; url="https://$domain/"; }
  fi
  [ -n "$url" ] || url="$(_site "$domain" home)"
  [ -n "$url" ] || url="https://$domain/"
  node "$SKILL/recipes-list.mjs" --json 2>/dev/null | python3 -c 'import json,sys
DOMAIN={"linkedin":"linkedin.com","x":"x.com","facebook":"facebook.com","instagram":"instagram.com",
        "reddit":"reddit.com","youtube":"youtube.com","hackernews":"news.ycombinator.com"}
want,pin,url=sys.argv[1],sys.argv[2],sys.argv[3]
rs=[r for r in json.load(sys.stdin) if not r["write"] and DOMAIN.get(r["site"])==want]
r=next((x for x in rs if x["key"]==pin), None) if pin else None
if r is None:
    rs.sort(key=lambda x: 0 if x["source"]=="registry" else 1)
    r=rs[0] if rs else None
if r is None: print("\t\t"+url)
else:
    # The cli string is a usage template: drop its placeholders ([n], <url>) so what is left is a
    # runnable command. A literal "[n]" once reached the page as JS and threw ReferenceError: n.
    cli="" if r["source"]=="registry" else " ".join(
        w for w in r["cli"].split() if not (w[:1] in "[<" and w[-1:] in "]>"))
    print("%s\t%s\t%s" % (r["key"], cli, url))' "$domain" "$key" "$url"; }

verify(){ local domain; domain="$(_domain_norm "${1:-}")"
  [ -n "$domain" ] || die "$EX_USAGE" "usage" "verify <domain> — e.g. chrome-agent verify linkedin.com"
  cj eval "1" >/dev/null 2>&1 || die "$EX_BROWSER" "browser-down" "no browser is servicing $SPOOL — run: chrome-agent up"
  local plan key cli url res how ok=false detail=""
  plan="$(_verify_plan "$domain")"
  key="$(printf '%s' "$plan" | cut -f1)"; cli="$(printf '%s' "$plan" | cut -f2)"; url="$(printf '%s' "$plan" | cut -f3)"
  if [ -n "$key" ]; then
    how="recipe:$key"
    # PUT THE TAB ON THE PAGE FIRST. _ensure_origin only navigates for the four sites it knows,
    # so `verify instagram.com` ran instagram:post against whatever page the tab happened to be on
    # — it scraped REDDIT, found images, and stamped instagram as verified (2026-09-12). A probe
    # that can pass while pointed at the wrong site proves nothing at all.
    goto "$url" 6
    # A chrome-agent verb is not a registry recipe — run it through this CLI, not through recipe().
    if [ -n "$cli" ]; then res="$($CA_SELF ${cli#chrome-agent } 2>/dev/null)"; else res="$(recipe "$key")"; fi
    # Three ways this fails, and all three used to read as success: an error, a result whose own
    # `url` is not this domain, and a read that came back EMPTY (a logged-out facebook feed returns
    # postCount:0 with no error — "the verb ran" is not "the verb works").
    if echo "$res" | python3 -c 'import sys,json,urllib.parse
dom=sys.argv[1]
d=json.load(sys.stdin)
if not isinstance(d,dict) or d.get("error"): sys.exit(1)
u=d.get("url") or ""
if u:
    h=urllib.parse.urlparse(u).netloc.lower()
    if not (h==dom or h.endswith("."+dom)): sys.exit(2)
counts=[len(v) for v in d.values() if isinstance(v,list)]
if counts and max(counts)==0: sys.exit(3)
sys.exit(0)' "$domain" 2>/dev/null; then ok=true
    else
      case $? in
        2) detail="the read ran on the wrong site: $(printf '%s' "$res" | python3 -c 'import sys,json;print(json.load(sys.stdin).get("url",""))' 2>/dev/null)" ;;
        3) detail="the read returned 0 items — signed out, or the recipe drifted" ;;
        *) detail="$(printf '%s' "$res" | head -c 200)" ;;
      esac
    fi
  else
    # No read recipe registered (news.ycombinator.com is the live example). Fall back to the auth
    # probe: "can we still read this site as ourselves" is the question either way.
    how="auth"; if res="$($CA_SELF auth "$domain" 2>/dev/null)"; then ok=true; else detail="$(printf '%s' "$res" | head -c 200)"; fi
  fi
  local today; today="$(date -u +%F)"
  if [ "$ok" = true ] && [ -f "$PLAYBOOKS/$domain/meta.md" ]; then
    python3 -c 'import re,sys
f,today,how=sys.argv[1],sys.argv[2],sys.argv[3]
t=open(f).read()
new="last_verified: %s (%s)" % (today,how)
t2,n=re.subn(r"(?m)^last_verified:.*$",new,t,count=1)
open(f,"w").write(t2 if n else t)' "$PLAYBOOKS/$domain/meta.md" "$today" "$how"
  fi
  python3 -c 'import json,sys
ok=sys.argv[1]=="true"
out={"domain":sys.argv[2],"verified":ok,"how":sys.argv[3]}
if ok: out["last_verified"]=sys.argv[4]
else:  out["detail"]=sys.argv[5]
print(json.dumps(out,separators=(",",":")))
sys.exit(0 if ok else 4)' "$ok" "$domain" "$how" "$today" "$detail"
}

usage(){ cat <<'EOF'
chrome-agent — social READ+WRITE (LinkedIn/X/YouTube/…) over the undetectable chromium fork.
It RUNS browser-research's verified recipes through the fork — no per-site reinvention.

  up [--headless] [url] | status | goto <url> | shot [path]
  recipes [--json]                every runnable verb (registry + chrome-agent's own), --json for tools
  recipe <site:name> [opts-json]  run ANY recipe through the fork (general, all sites)
  evalAsync '<async-js>'          run any promise-returning JS and get the result

  FAST-LEARNING:
  capture arm|dump|clear          learn a site's REAL API: arm, do the action by hand, dump
  learn <name> [url]              capture screenshot+DOM to Read/grep

  linkedin post "<text>" [--confirm]           staged unless --confirm (API replay, no composer)
  linkedin post-image "<text>" <img> [--confirm]
  linkedin feed
  x post "<text>" [--confirm]
  hackernews top [n] | hackernews item <url-or-id>   read HN back (reports [flagged]/[dead])
  watch <video-url>               YouTube/IG/X video -> mp3 -> transcript.md

  IDENTITY (domain-scoped — a profile is signed into SITES, not into "a thing"):
  auth <domain>                   read-only: {signed_in, as?}   exit 0 = yes, 2 = no
  login <domain>                  open the window there for a HUMAN; types nothing
  verify <domain>                 run the site's real read recipe; stamp playbook last_verified
  note <domain> "<learned>"       capture site knowledge the moment you learn it
  promote [<domain>] [--apply] [--notes-only]   review what is known but not in the playbook
  read <domain> [generic:recipe]  read any known site — its own recipe, or the generic reader
  logout <domain>                 end THIS site's session; verifies with auth afterwards
  profile create <dir> | list | delete <dir> [--yes]
  sites list | show <domain> | path <domain> | validate | sync [--force]
  doctor                          is this machine able to run anything at all?
  install [bindir]                sites -> ~/.config/chrome-agent/sites (editable), CLI -> PATH
  ledger status|rotate            the audit trail: who did what, and its rotation
  share start|status|stop         time-boxed remote login window on a server (ADR 0003)
  profile | spool                 which profile/spool this invocation resolves to
  exit-codes [--json]             0 ok · 1 usage · 2 not signed in · 3 browser down · 4 site refused

  The fork lives at $CHROME_AGENT_FORK (default: ~/muthu/gitworkspace/chromium).

WRITES are STAGED by default (safety contract from post.js) — nothing publishes without --confirm.
EOF
}

# FORK PREFLIGHT AT THE TOP LEVEL, not only inside cj/cjt. A `die` in cj runs inside a command
# substitution or a pipeline — i.e. a subshell — so its exit never reaches the caller and its JSON
# is swallowed by whatever was capturing stdout. Checking here means a missing fork exits 3 with
# the message on the caller's stdout, which is the whole point of a documented exit code.
case "${1:-}" in
  spool|profile|recipes|exit-codes|exitcodes|help|-h|--help|'') ;;
  *) _require_fork ;;
esac

case "${1:-}" in
  spool) echo "$SPOOL";;
  profile) case "${2:-}" in
      create) profile_create "${3:-}";;
      list) profile_list;;
      delete|rm) profile_delete "${3:-}" "${4:-}";;
      ''|show) echo "$PROFILE";;
      *) die "$EX_USAGE" "usage" "profile [create <dir> | list | delete <dir> [--yes]]";; esac;;
  auth) auth "${2:-}";; login) login "${2:-}";; logout) logout "${2:-}";; verify) verify "${2:-}";;
  doctor) doctor;;
  read) read_site "${2:-}" "${3:-}";;
  install) install_ "${2:-}";;
  ledger) ledger "${2:-status}";;
  share) shift; share "$@";;
  sites) shift; case "${1:-list}" in
      list) python3 "$SITES_PY" list "${2:-}";;
      show|resolve) python3 "$SITES_PY" resolve "${2:-}";;
      path) python3 "$SITES_PY" path "${2:-}";;
      validate) shift; python3 "$SITES_PY" validate "$@";;
      sync) shift; python3 "$SITES_PY" sync "$@";;
      *) die "$EX_USAGE" "usage" "sites list|show <domain>|path <domain>|validate|sync [--force]";; esac;;
  exit-codes|exitcodes) exit_codes "${2:-}";;
  up) shift; up "${1:-}" "${2:-}";; status) status;; goto) goto "${2:-}";; shot) shot "${2:-}";;
  recipes) recipes "${2:-}";; recipe) recipe "${2:-}" "${3:-}" "${4:-}";; evalasync|evalAsync) evalAsync "${2:-}" "${3:-20}";;
  evalwithcsp) evalwithcsp "${2:-}" "${3:-20}";; evalwithoutcsp) evalwithoutcsp "${2:-}" "${3:-20}";;
  do) do_verify "${2:-}" "${3:-}" "${4:-}";;
  capture) shift; capture "${1:-}";; learn) learn "${2:-cap}" "${3:-}";;
  linkedin) shift; case "${1:-}" in
      post) li_post "$2" "${3:-}";; post-image) li_post_image "$2" "$3" "${4:-}";; feed) li_feed;;
      like) li_like "${2:-}" "${3:-}";;
      *) usage;; esac;;
  x) shift; case "${1:-}" in
      post) x_post "$2" "${3:-}";; like) x_like "${2:-}" "${3:-}";; repost) x_repost "${2:-}" "${3:-}";;
      reply) recipe "x:reply" "${2:-}";; *) usage;; esac;;
  reddit) shift; case "${1:-}" in
      upvote) reddit_upvote "${2:-}" "${3:-}";; comment) recipe "reddit:comment" "${2:-}";; post) recipe "reddit:post" "${2:-}";;
      *) usage;; esac;;
  note) note "${2:-}" "${3:-}";;
  promote) shift; promote "$@";;
  hackernews|hn) shift; case "${1:-}" in
      item|thread) hn_item "${2:-}";; top|front) hn_top "${2:-30}";;
      post) recipe "hackernews:post" "${2:-}";; comment) recipe "hackernews:comment" "${2:-}";;
      *) usage;; esac;;
  watch) watch "$2";;
  # tab primitives (pass-through to the fork). The skill gives EACH session its own dedicated
  # tab automatically (NEWTAB acks a stable tabId; goto/eval/screenshot ride it via TAB:<tabId>|),
  # so a lane never has to remember-and-restore the active tab and can no longer steer anyone
  # else's. These raw primitives remain for manual inspection / one-off tab management.
  tabs|listtabs) cj listtabs;;
  newtab)   cj newtab "${2:-about:blank}" >/dev/null 2>&1; sleep "${3:-3}";;
  selecttab) cj selecttab "${2:-0}" >/dev/null 2>&1;;
  closetab)  cj closetab "${2:-}" >/dev/null 2>&1;;

  # ---- per-session tab (native tabId; the skill maintains this internally) ----------------------
  mytab)     # which tabId is this session's, and where is it?
    _t="$(_ensure_tab)"
    printf '{"agent":"%s","tabId":"%s","url":"%s"}\n' "$(_tab_id)" "$_t" "$(val 'location.href')" ;;
  whosetab)  # describe the tab carrying a given tabId (LISTTABS now reports tabId across windows)
    cj listtabs | python3 -c 'import sys,json
tid=sys.argv[1] if len(sys.argv)>1 else ""
d=json.load(sys.stdin).get("value",[])
t=next((x for x in d if x.get("tabId")==tid),None)
print(json.dumps(t) if t else json.dumps({"error":"no tab with tabId "+tid}))' "${2:-}" ;;
  *) usage;;
esac
